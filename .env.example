# PostgreSQL mode; sample data is imported only by an explicit seed command.
ERP_DEMO_MODE=false
# Host-side Prisma/local Next connection. Compose connects to postgres:5432 internally.
DATABASE_URL="postgresql://erp:erp_local_only@localhost:5433/erp?schema=public"
POSTGRES_PASSWORD=erp_local_only
POSTGRES_PORT=5433
APP_PORT=3000

# Generate a secret: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 also accepts AUTH_SECRET / AUTH_URL; when set they take precedence.
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# Explicit sample initializer: npm run db:seed (or npx prisma db seed).
# These are sample credentials only. No account is created at application startup.
SEED_MODE=sample
SEED_ADMIN_EMAIL=admin@erp.dev
SEED_ADMIN_PASSWORD=Admin123!
SEED_WORKSPACE_NAME="Evo Sample Company"
# Optional reproducible calendar anchor; empty uses today's UTC date.
SEED_REFERENCE_DATE=
# For real initial setup: SEED_MODE=bootstrap, custom email and password >=12 chars.
# SEED_ONLY_IF_EMPTY=true
# Explicit production build opt-in for the public training workspace only.
# SEED_PUBLIC_SAMPLE=true

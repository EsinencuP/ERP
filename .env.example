# Explicit opt-in; never use demo mode for real customer data.
ERP_DEMO_MODE=true
DATABASE_URL="postgresql://erp:erp_local_only@localhost:5433/erp?schema=public"
# Required only for db:seed. No default credentials in PostgreSQL mode.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_WORKSPACE_NAME="Моя компания"
